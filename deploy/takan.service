# Systemd unit for the Takan hub: the panel, the MCP endpoint and the
# takan-agent WebSocket, all in one process.
#
#   sudo mkdir -p /opt/takan/data /opt/takan/agents /etc/takan
#   sudo cp deploy/takan.env.example /etc/takan/takan.env   # then edit it
#   sudo chmod 600 /etc/takan/takan.env
#   sudo cp deploy/takan.service /etc/systemd/system/takan.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now takan

[Unit]
Description=Takan hub (panel + MCP + machine agents)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=debian
Group=debian
WorkingDirectory=/opt/takan
EnvironmentFile=/etc/takan/takan.env

ExecStart=/opt/takan/takan
Restart=always
RestartSec=5

# The hub spawns no children: it serves HTTP and talks to SQLite. 512M is a
# generous cap for that, and the cap is what stops a leak from taking the box
# down rather than one service.
MemoryMax=512M
# Swap thrashing on this box is worse than an OOM kill.
MemorySwapMax=0
LimitNOFILE=65535

NoNewPrivileges=true
PrivateTmp=true
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=takan

[Install]
WantedBy=multi-user.target

# Hub configuration. Copy to /etc/takan/takan.env and chmod 600.

# The reverse proxy must point at this port, and deploy/deploy.sh reads it back
# out of this file to health-check the right listener. vps2 runs on 8096.
TAKAN_LISTEN=127.0.0.1:8090
# URL browsers, MCP clients and /install.sh must use.
TAKAN_PUBLIC_URL=https://takan.example.com
TAKAN_DATA_DIR=/opt/takan/data

# openssl rand -hex 32 — encrypts the vault, Mercadona and email credentials.
# Do NOT lose it and do NOT rotate it casually: everything sealed with the old
# key becomes unreadable.
TAKAN_SESSION_KEY=change-me-long-random

# --- panel sign-in ---
# Single-operator instance. Sign-in is a one-time code emailed to this address:
# whoever reads this mailbox owns the panel. Required — login fails closed.
TAKAN_OWNER_EMAIL=you@example.com
# From address for login-code mail (default: login@<first Resend domain>).
# TAKAN_AUTH_EMAIL_FROM=login@example.com
# Resend key for login mail. Only needed before the panel has one saved, i.e.
# the very first sign-in on a fresh instance.
# TAKAN_RESEND_API_KEY=
# Send-code throttle, applied per IP and globally.
# TAKAN_LOGIN_CODE_PER_WINDOW=3
# TAKAN_LOGIN_CODE_WINDOW_MIN=15

# --- rate limits (per minute; 0 = unlimited) ---
# TAKAN_AUTH_PER_MIN=20
# TAKAN_MACHINE_BASH_PER_MIN=30

# Directory of takan-agent-<os>-<arch> binaries served at /download/ and /install.sh
# TAKAN_AGENT_BIN_DIR=/opt/takan/agents

# --- optional continuous backup (Colmena → S3-compatible) ---
# TAKAN_BACKUP_ENDPOINT=https://s3.example.com
# TAKAN_BACKUP_REGION=us-east-1
# TAKAN_BACKUP_BUCKET=takan-backups
# TAKAN_BACKUP_PREFIX=takan/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

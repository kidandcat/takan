TAKAN_LISTEN=127.0.0.1:8090
# URL browsers, MCP clients, and /install.sh must use (LAN IP or https://takan.example.com).
TAKAN_PUBLIC_URL=https://takan.example.com
TAKAN_DATA_DIR=/opt/takan/data
# openssl rand -hex 32 — encrypts vault / Mercadona / email / telegram / SIP. Do not lose it.
TAKAN_SESSION_KEY=change-me-long-random

# Single-operator instance: first panel visit sets the password.
# TAKAN_ALLOW_REGISTER and TAKAN_DEFAULT_INVITE_QUOTA are ignored.

# Rate limits (per minute; 0 = unlimited)
# TAKAN_AUTH_PER_MIN=20
# TAKAN_MACHINE_BASH_PER_MIN=30

# Directory of takan-agent-<os>-<arch> binaries served at /download/ and /install.sh
# TAKAN_AGENT_BIN_DIR=/opt/takan/agents

# Optional Grok Bot webhook routine (URL + sender key from the routine UI).
# POSTed as JSON when a machine AI job reaches done/failed/cancelled.
# Auth: Authorization: Bearer <sender key> (also X-Webhook-Key / X-Grok-Webhook-Secret).
# TAKAN_GROK_BOT_WEBHOOK_URL=
# TAKAN_GROK_BOT_WEBHOOK_SECRET=

# Optional continuous backup (Colmena → S3-compatible: AWS, MinIO, OVH, …)
# TAKAN_BACKUP_ENDPOINT=https://s3.example.com
# TAKAN_BACKUP_REGION=us-east-1
# TAKAN_BACKUP_BUCKET=takan-backups
# TAKAN_BACKUP_PREFIX=takan/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Hub configuration. Copy to /etc/takan/takan.env and chmod 600.
#
# Every ATLAS_* name is also accepted as TAKAN_* (deprecated, logged once), so
# this file can be renamed independently of the binary.

ATLAS_LISTEN=127.0.0.1:8090
# URL browsers, MCP clients and /install.sh must use.
ATLAS_PUBLIC_URL=https://takan.example.com
# Host the phone app talks to. Only /v1/* is served there; everything else 404s.
# Defaults to ATLAS_PUBLIC_URL when unset.
# ATLAS_APP_URL=https://app.example.com
ATLAS_DATA_DIR=/opt/takan/data
# Loopback API: /health, /jobs, /tasks, /internal/*. Never reverse-proxied.
# This is what atlas-send / atlas-sched / atlas-task and Gatus talk to.
ATLAS_LOCAL_ADDR=127.0.0.1:8099

# openssl rand -hex 32 — encrypts the vault, the Telegram token, Mercadona and
# email credentials. Do NOT lose it and do NOT rotate it casually: everything
# sealed with the old key becomes unreadable.
ATLAS_SESSION_KEY=change-me-long-random

# --- panel sign-in ---
# Single-operator instance. Sign-in is a one-time code emailed to this address:
# whoever reads this mailbox owns the panel. Required — login fails closed.
ATLAS_OWNER_EMAIL=you@example.com
# From address for login-code mail (default: login@<first Resend domain>).
# ATLAS_AUTH_EMAIL_FROM=login@example.com
# Resend key for login mail. Only needed before the panel has one saved, i.e.
# the very first sign-in on a fresh instance.
# ATLAS_RESEND_API_KEY=
# Send-code throttle, applied per IP and globally.
# ATLAS_LOGIN_CODE_PER_WINDOW=3
# ATLAS_LOGIN_CODE_WINDOW_MIN=15

# --- assistant ---
# One bot, from @BotFather. Sealed into the database on first boot; after that
# this line can be removed and the stored copy is used.
TELEGRAM_BOT_TOKEN=123456:AA...
# YOUR Telegram *user* id (ask @userinfobot). This is the whole authorization
# model: the assistant answers this id and nobody else, in DMs and in groups.
# Without it the assistant refuses to start.
OWNER_TELEGRAM_ID=282611642
# Optional: transcribes voice notes.
# GROQ_API_KEY=gsk_...
# Optional: bearer token for the phone app (/v1/*). Unset disables that channel.
# ATLAS_APP_TOKEN=
# Optional: FCM service account JSON, for push when the app is closed.
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# Where the CLI agent looks for its credentials (~/.grok). Defaults to $HOME.
# ATLAS_AGENT_HOME=/home/debian
# One-shot import of the standalone daemon's state and config.toml. Remove it
# once the boot log reports the import; the files are renamed, never deleted.
# ATLAS_LEGACY_DIR=/home/debian/atlas-data

# Everything else about the assistant — the agent command, its arguments, the
# timeouts, respond_to_all — is edited in the panel, not here.

# --- rate limits (per minute; 0 = unlimited) ---
# ATLAS_AUTH_PER_MIN=20
# ATLAS_MACHINE_BASH_PER_MIN=30

# Directory of takan-agent-<os>-<arch> binaries served at /download/ and /install.sh
# ATLAS_AGENT_BIN_DIR=/opt/takan/agents

# --- optional continuous backup (Colmena → S3-compatible) ---
# ATLAS_BACKUP_ENDPOINT=https://s3.example.com
# ATLAS_BACKUP_REGION=us-east-1
# ATLAS_BACKUP_BUCKET=takan-backups
# ATLAS_BACKUP_PREFIX=takan/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

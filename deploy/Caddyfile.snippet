# One host, one process: the panel, MCP, OAuth, the takan-agent WebSocket and
# /install.sh are all served from the same listener.
#
# Replace the placeholder with your own host. Nothing in the binary knows a
# domain; it comes from TAKAN_PUBLIC_URL.
#
# The upstream port must be the hub's TAKAN_LISTEN from /etc/takan/takan.env —
# 8090 here is only this file's default, and vps2 runs on 8096. Check the env
# file before pasting; a stale port here is a 502 on every request while the
# service itself looks perfectly healthy.

takan.example.com {
	reverse_proxy 127.0.0.1:8090 {
		# MCP clients hold an SSE stream: no buffering, no read deadline.
		flush_interval -1
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}
